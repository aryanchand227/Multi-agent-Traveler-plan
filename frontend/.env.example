# ==============================================================================
# AI Travel Planner - Frontend Environment Configuration Example
# Copy this file to .env.local for local development.
# In Vercel, set this environment variable in Project Settings -> Environment Variables.
# NEVER put backend secrets or Groq API keys here!
# ==============================================================================

# Public API URL pointing to the FastAPI backend.
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production on Render example:
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
