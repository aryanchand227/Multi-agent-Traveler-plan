# ==============================================================================
# AI Travel Planner - Backend Environment Configuration Example
# Copy this file to .env and fill in your actual values.
# NEVER commit real secret keys, database credentials, or API keys to Git.
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development
APP_NAME="AI Travel Planner"
APP_VERSION=1.0.0
DEBUG=true

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database
# Local SQLite default (used in development):
DATABASE_URL=sqlite+aiosqlite:///./travel_planner.db
# Supabase PostgreSQL Examples (both postgresql:// and postgresql+asyncpg:// are automatically supported):
# Option 1: Direct Connection (Port 5432):
# DATABASE_URL=postgresql+asyncpg://postgres:<your-password>@db.<your-project-ref>.supabase.co:5432/postgres
# Option 2: Connection Pooler (PgBouncer Port 6543, recommended for cloud platforms):
# DATABASE_URL=postgresql+asyncpg://postgres.<your-project-ref>:<your-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Security & Authentication
# Generate a secure 32+ character key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-in-production-secret-key-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
MAX_REQUEST_BODY_BYTES=65536

# Proxy & Networking (Render / Cloudflare / Nginx)
# In production on Render, set TRUST_ALL_PROXIES=true so X-Forwarded-For is trusted from Render's proxy
TRUSTED_PROXIES=["127.0.0.1","::1"]
TRUST_ALL_PROXIES=false

# CORS Origins (JSON list or comma-separated strings without trailing slash)
# Production frontend URL:
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://multi-agent-traveler-plan.vercel.app"]

# LLM Provider Configuration
# Supported providers: groq, openai, gemini
LLM_PROVIDER=groq
# Working Groq model identifier:
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
LLM_TEMPERATURE=0.3
LLM_MAX_RETRIES=2
LLM_REQUEST_TIMEOUT=30

# Agent Configuration
MAX_AGENT_ITERATIONS=5
MAX_AGENT_RETRIES=2
AGENT_TIMEOUT_SECONDS=60

# Output Token Limits
OUTPUT_TOKENS_BRIEF=500
OUTPUT_TOKENS_STANDARD=1200
OUTPUT_TOKENS_DETAILED=2500

# Rate Limiting & Guardrails
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_ANONYMOUS_PER_MINUTE=10
RATE_LIMIT_USER_PER_MINUTE=20
TRAVEL_PLANS_PER_USER_PER_DAY=10
TRAVEL_PLANS_PER_IP_PER_DAY=20
MAX_CONCURRENT_PLANS_TOTAL=3
MAX_LLM_CALLS_PER_PLAN=20

# Application LLM Spending Limits (USD)
DAILY_LLM_BUDGET_USD=2.00
MONTHLY_LLM_BUDGET_USD=20.00

# Optional External Travel APIs (Leave empty to use built-in mock providers for demo)
WEATHER_API_KEY=
BUS_API_KEY=
TRAIN_API_KEY=
FLIGHT_API_KEY=
HOTEL_API_KEY=
